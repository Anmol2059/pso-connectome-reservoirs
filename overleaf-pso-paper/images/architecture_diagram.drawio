    <mxCell id="14" value="&lt;b&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;&#x1F52C; ESN Reservoir&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;&lt;i&gt;State update:&lt;/i&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;x(t) = tanh(W&amp;middot;x(t&amp;minus;1) + W&lt;sub&gt;in&lt;/sub&gt;&amp;middot;u(t))&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#4527A0&quot;&gt;&amp;rho;(W) = 0.97&amp;nbsp;&amp;nbsp;&amp;middot;&amp;nbsp;&amp;nbsp;washout = 200&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#880E4F&quot; style=&quot;font-size:9px;&quot;&gt;&#x2756; Bio-A initialisation&lt;br/&gt;&#x2756; Sparsity pattern frozen&lt;br/&gt;&#x2756; Only edge weights optimised&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#546E7A&quot; style=&quot;font-size:8px;&quot;&gt;1000 evals/run&amp;nbsp;&amp;middot;&amp;nbsp;10 runs per condition&lt;br/&gt;GPU-batched objective (PyTorch)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=3;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="545" y="80" width="255" height="648" as="geometry" />
    </mxCell>

    <mxCell id="15" value="&lt;b&gt;&#x1F4D0; Ridge Regression&lt;/b&gt;&lt;br/&gt;&lt;i&gt;W&lt;sub&gt;out&lt;/sub&gt; = (X&lt;sup&gt;T&lt;/sup&gt;X + &amp;alpha;I)&lt;sup&gt;&amp;minus;1&lt;/sup&gt;X&lt;sup&gt;T&lt;/sup&gt;y&lt;/i&gt;&lt;br/&gt;&lt;font color=&quot;#880E4F&quot; style=&quot;font-size:8px;&quot;&gt;70% train · 30% test&lt;br/&gt;&amp;alpha;=1.0 (opt) · RidgeCV (baseline)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#880E4F;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="822" y="315" width="175" height="100" as="geometry" />
    </mxCell>

    <mxCell id="16" value="&lt;b&gt;&#x1F4CA; Memory Capacity&lt;/b&gt;&lt;br/&gt;&lt;i&gt;MC = &amp;sum; r&amp;sup2;(&amp;#251;(t&amp;minus;k), u(t&amp;minus;k))&lt;/i&gt;&lt;br/&gt;&lt;font color=&quot;#1B5E20&quot; style=&quot;font-size:8px;&quot;&gt;k = 1..50&amp;nbsp;&amp;middot;&amp;nbsp;higher = better &amp;uarr;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
